# Copy to api/.env for local development. Names and purposes only; no secrets here.

# Version label returned as defaults_version in responses.
LQ_DEFAULTS_VERSION=defaults_v1

# Owner-confirmed defaults (90 minutes, $30 as minor units). Usually leave as-is.
LQ_DEFAULT_AVAILABLE_SECONDS=5400
LQ_DEFAULT_BUDGET_AMOUNT_MINOR=3000

# REQUIRED, still undecided by the team: ISO 4217 code for the $30 default.
# Unset = quest requests fail with CONFIGURATION_ERROR.
LQ_DEFAULT_CURRENCY=USD

# Optional extra currencies accepted on supplied budgets, as a JSON list.
# LQ_SUPPORTED_CURRENCIES=["USD"]

# Optional, still undecided: fallbacks when the request omits start/timezone.
# Unset = such requests fail with CONFIGURATION_ERROR (never guessed).
# LQ_NEIGHBORHOOD_ANCHOR_LATITUDE=
# LQ_NEIGHBORHOOD_ANCHOR_LONGITUDE=
# LQ_DEFAULT_TIMEZONE=

# Copy to snowflake/.env (gitignored) and fill in. Never commit the real file.
# Account identifier: <orgname>-<account_name>, shown in Snowsight under your
# profile > Account > "Copy account identifier" (use a hyphen, not a dot).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Absolute path to the PKCS#8 private key (.p8); keep it outside the repository.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only if the private key is encrypted.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Database the API calls (LOCAL_QUEST).
LQ_DB=LOCAL_QUEST

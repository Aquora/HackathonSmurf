# Local Quest configuration: one file for the API and the Snowflake scripts.
# Copy to .env in this folder (local-quest/.env) and fill in. Never commit .env.
# Empty values are treated as unset. Real environment variables override this file.
# The API reads it when started from api/ (as ../.env); snowflake/scripts/lq.py reads it too.

# ---------- API server ----------
APP_ENV=development             # development | test | production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info                  # critical | error | warning | info | debug
TRUST_PROXY=false               # true when behind a load balancer / reverse proxy
CORS_ORIGINS=http://localhost:3000   # comma-separated allowed frontend origins
RATE_LIMIT_PER_MINUTE=30        # per client IP, per process
QUEST_TIMEZONE=America/Los_Angeles   # IANA zone used for arrival/departure times
DEFAULT_START_ADDRESS=3801 W Temple Ave, Pomona, CA 91768   # used when a request omits location
ALLOW_MOCK_IN_PRODUCTION=false  # production refuses mock adapters unless true

# ---------- AI model (parses the user text and plans the route) ----------
AI_PROVIDER=mock                # snowflake (Cortex, no extra key) | cursor (OpenAI-compatible URL+key) | mock
CURSOR_API_BASE_URL=            # e.g. https://<gateway>/v1  (the client appends /chat/completions)
CURSOR_API_KEY=
CURSOR_MODEL=
CURSOR_TIMEOUT_S=30
CURSOR_MAX_RETRIES=2
CURSOR_JSON_MODE=true           # send response_format=json_object; set false if unsupported

# Model step on Snowflake Cortex (AI_PROVIDER=snowflake): uses the Snowflake login below,
# no extra key. Tested 2026-10-23: llama3.3-70b and llama3.1-8b work on this account.
SNOWFLAKE_AI_MODEL=llama3.3-70b

# ---------- Snowflake ----------
DATA_PROVIDER=mock              # snowflake | mock
SNOWFLAKE_ACCOUNT=              # <orgname>-<account_name>, e.g. ABCDEFG-XY12345
SNOWFLAKE_USER=                 # the LOGIN name (key-pair auth uses it)
SNOWFLAKE_PASSWORD=             # or use key-pair auth below (preferred)
SNOWFLAKE_PRIVATE_KEY_PATH=     # absolute path to the .p8 key, kept outside the repository
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=LQ_WH
SNOWFLAKE_DATABASE=LOCAL_QUEST
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_ROLE=LQ_APP_RO        # can only call the procedure below
SNOWFLAKE_LOCATIONS_PROCEDURE=LOCAL_QUEST.APP.FIND_QUEST_LOCATIONS
SNOWFLAKE_QUERY_TIMEOUT_S=20
SNOWFLAKE_POOL_MAX=4
